{
  "name": "server",
  "version": "1.0.0",
  "description": "Backend API Server for KerjainYu",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && npm run db:up && npm run migrate:up",
    "migrate:make": "knex migrate:make --knexfile src/database/knexfile.js",
    "migrate:up": "knex migrate:latest --knexfile src/database/knexfile.js",
    "migrate:rollback": "knex migrate:rollback --knexfile src/database/knexfile.js",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodebyCola/KerjainYu.git"
  },
  "author": "TerbitanTerbaru",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/CodebyCola/KerjainYu/issues"
  },
  "homepage": "https://github.com/CodebyCola/KerjainYu#readme",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "knex-stringcase": "^1.6.0",
    "lodash": "^4.18.1",
    "pg": "^8.22.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.10"
  }
}
